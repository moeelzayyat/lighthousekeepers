@@ -0,0 +1,142 @@
+-- Voyages (multi-ship phase 2): takes a departed crew from the harbor to its own Lighthouse Isle server,
+-- and brings players back to the harbor.
+--
+-- TELEPORT_ENABLED = false (default, and the only mode usable in Studio): launch() SIMULATES the voyage. The
+-- crew is moved back to the harbor spawn and leaves the party, so boarding and countdowns can be tested.
+--
+-- TELEPORT_ENABLED = true (owner-only, needs the Isle place and a published test environment):
+--   1. ReserveServer(ISLE_PLACE_ID) -> access code + private server id
+--   2. a MANIFEST in MemoryStore (map "Voyages", key = private server id, short expiry): the crew's UserIds,
+--      ship and forecast votes. No balances, inventory or progress ever travel: the Isle loads saves itself.
+--   3. PlayerData.handoff(player) for each member (awaited final save + session release; see SessionLock)
+--   4. TeleportAsync(ISLE_PLACE_ID, crew, options) with ReservedServerAccessCode. TeleportData only carries
+--      { ship } for the loading screen and is never trusted.
+--   A member whose teleport fails stays in the harbor, keeps the party seat (normal boarding rules apply again)
+--   and their save session is re-claimed by the harbor (PlayerData.reclaim). Nothing is deleted.
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local TeleportService = game:GetService("TeleportService")
+
+local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
+
+local Voyages = {}
+
+local MANIFEST_MAP = "Voyages"
+local MANIFEST_SECONDS = 600
+
+local deps = nil
+
+-- deps: notify(player, text), log(kind, data), sendToHarbor(player) (move to the harbor spawn),
+--       playerData (handoff/reclaim, teleport mode only), roster (ShipRoster)
+function Voyages.init(d)
+	deps = d
+	if Config.TELEPORT_ENABLED then
+		TeleportService.TeleportInitFailed:Connect(function(player, result, message)
+			Voyages.teleportFailed(player, tostring(result) .. " " .. tostring(message))
+		end)
+	end
+end
+
+local function simulate(shipId, crew)
+	deps.log("VoyageLaunched", { ship = shipId, crew = #crew, mode = "simulated" })
+	for _, player in crew do
+		deps.notify(player, "(Studio test) Your ship sailed to Lighthouse Isle. Teleporting is off, so you are back in the harbor.")
+		deps.roster.leave(player, "sailed (simulated)")
+		deps.sendToHarbor(player)
+	end
+end
+
+local function teleport(shipId, crew)
+	assert(Config.ISLE_PLACE_ID ~= 0, "ISLE_PLACE_ID is not set")
+	-- never move a player between servers without the guarded save hand-off
+	assert(deps.playerData and deps.playerData.handoff and deps.playerData.reclaim, "save hand-off adapter not wired: refusing to teleport")
+	local code, privateServerId = TeleportService:ReserveServer(Config.ISLE_PLACE_ID)
+	local userIds = {}
+	for _, player in crew do
+		table.insert(userIds, player.UserId)
+	end
+	local manifest = { ship = shipId, userIds = userIds, createdAt = os.time() }
+	game:GetService("MemoryStoreService"):GetSortedMap(MANIFEST_MAP):SetAsync(privateServerId, manifest, MANIFEST_SECONDS)
+	-- hand every save over before anyone leaves (awaited final save + release); a member whose hand-off
+	-- fails does not travel
+	local travelling = {}
+	for _, player in crew do
+		if deps.playerData.handoff(player) then
+			table.insert(travelling, player)
+		else
+			Voyages.teleportFailed(player, "save hand-off failed")
+		end
+	end
+	if #travelling == 0 then
+		return
+	end
+	local options = Instance.new("TeleportOptions")
+	options.ReservedServerAccessCode = code
+	options:SetTeleportData({ ship = shipId })
+	deps.log("VoyageLaunched", { ship = shipId, crew = #travelling, mode = "teleport", server = privateServerId })
+	local ok, err = pcall(TeleportService.TeleportAsync, TeleportService, Config.ISLE_PLACE_ID, travelling, options)
+	if not ok then
+		for _, player in travelling do
+			Voyages.teleportFailed(player, tostring(err))
+		end
+	end
+end
+
+-- A member who could not travel: still in the harbor, keeps the seat, keeps (re-claims) the save session.
+function Voyages.teleportFailed(player, why)
+	if player.Parent ~= Players then
+		return
+	end
+	deps.log("TeleportFailed", { player = player.Name, why = why })
+	if deps.playerData and deps.playerData.reclaim then
+		deps.playerData.reclaim(player)
+	end
+	if deps.roster.shipOf(player) ~= nil then
+		player:SetAttribute("BoardedByDeck", true) -- normal boarding rules apply again (stepping off frees the seat)
+	end
+	deps.notify(player, "The ship couldn't reach Lighthouse Isle. You're still in the harbor with your crew seat. Try SAIL NOW again.")
+end
+
+-- Called by HarborDepartures at the end of a ship's countdown.
+function Voyages.launch(shipId, crew)
+	if Config.TELEPORT_ENABLED then
+		teleport(shipId, crew)
+	else
+		simulate(shipId, crew)
+	end
+end
+
+-- Isle side: send one player back to a public harbor server (Results "back to harbor", menu, rematch "no").
+-- Returns false when teleporting is off (the caller keeps today's behaviour).
+function Voyages.returnToHarbor(player)
+	if not Config.TELEPORT_ENABLED then
+		return false
+	end
+	if not (deps.playerData and deps.playerData.handoff) then
+		warn("[Voyages] save hand-off adapter not wired: not teleporting " .. player.Name)
+		return false
+	end
+	if not deps.playerData.handoff(player) then
+		deps.notify(player, "Saving your progress before the trip back failed. Try again in a moment.")
+		return true
+	end
+	local ok, err = pcall(TeleportService.TeleportAsync, TeleportService, Config.HARBOR_PLACE_ID, { player })
+	if not ok then
+		Voyages.teleportFailed(player, tostring(err))
+	end
+	return true
+end
+
+-- Isle side: read this reserved server's manifest. Returns nil outside a reserved server or when missing.
+function Voyages.readManifest()
+	if not Config.TELEPORT_ENABLED or game.PrivateServerId == "" then
+		return nil
+	end
+	local ok, manifest = pcall(function()
+		return game:GetService("MemoryStoreService"):GetSortedMap(MANIFEST_MAP):GetAsync(game.PrivateServerId)
+	end)
+	return if ok then manifest else nil
+end
+
+return Voyages
diff --git a/src/ServerScriptService/Server/IsleAdmission.luau b/src/ServerScriptService/Server/IsleAdmission.luau
new file mode 100644
index 0000000..aa3cf41
--- /dev/null
+++ b/src/ServerScriptService/Server/IsleAdmission.luau
@@ -0,0 +1,109 @@
+-- IsleAdmission (multi-ship phase 2, isle role only): who the crew of this Lighthouse Isle server is, and when
+-- its voyage starts. It plugs into the EXISTING voyage loop (GameState) through the same two hooks the
+-- single-server game uses (deps.departure and deps.departShip), so no game logic is duplicated.
+--
+--   * reserved server with a manifest (Voyages): only the listed UserIds are crew; anyone else is sent back to
+--     the harbor. The voyage starts when everyone listed has arrived, or ISLE_ARRIVAL_WAIT seconds after the
+--     first one did (crew-size scaling already uses the real count).
+--   * no manifest (Studio test with PLACE_ROLE_OVERRIDE = "isle"): everyone who joins is crew, same timing.
+--   * Play Again: the players who chose it sail again in this same server (GameState's rematch flow).
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
+
+local IsleAdmission = {}
+
+local SHIP_ID = "Isle"
+
+local deps = nil
+local expected = nil -- { [userId] = true } from the manifest, or nil = anyone
+local expectedCount = 0
+local firstArrival = nil
+local started = false
+local rematchWanted = false
+
+local function admitted()
+	local list = {}
+	for _, player in Players:GetPlayers() do
+		if player:GetAttribute("InLobby") == true and (expected == nil or expected[player.UserId]) then
+			table.insert(list, player)
+		end
+	end
+	return list
+end
+
+-- deps: manifest (table or nil), sendToHarbor(player), log(kind, data)
+function IsleAdmission.init(d)
+	deps = d
+	if d.manifest and d.manifest.userIds then
+		expected = {}
+		for _, id in d.manifest.userIds do
+			expected[id] = true
+			expectedCount += 1
+		end
+	end
+	local function onJoin(player)
+		if expected and not expected[player.UserId] then
+			deps.log("IsleRefused", { player = player.Name })
+			deps.sendToHarbor(player)
+		end
+	end
+	Players.PlayerAdded:Connect(onJoin)
+	for _, player in Players:GetPlayers() do
+		onJoin(player)
+	end
+end
+
+-- GameState: is there a voyage to start?
+function IsleAdmission.requested()
+	if started then
+		if not rematchWanted then
+			return false
+		end
+		for _, player in Players:GetPlayers() do
+			if player:GetAttribute("Ready") == true then
+				return true
+			end
+		end
+		rematchWanted = false -- everyone who wanted it left
+		return false
+	end
+	local list = admitted()
+	if #list == 0 then
+		return false
+	end
+	firstArrival = firstArrival or os.clock()
+	local everyone = expected ~= nil and #list >= expectedCount
+	return everyone or os.clock() - firstArrival >= (Config.ISLE_ARRIVAL_WAIT or 20)
+end
+
+-- GameState: the countdown finished; these players sail (the existing loop takes them to the lighthouse).
+function IsleAdmission.depart()
+	if started and rematchWanted then
+		rematchWanted = false
+		local crew = {}
+		for _, player in Players:GetPlayers() do
+			if player:GetAttribute("Ready") == true then
+				table.insert(crew, player)
+			end
+		end
+		return crew
+	end
+	started = true
+	local crew = admitted()
+	for _, player in crew do
+		player:SetAttribute("ShipId", SHIP_ID)
+		player:SetAttribute("Ready", true)
+	end
+	deps.log("IsleVoyage", { crew = #crew, expected = expectedCount })
+	return crew
+end
+
+-- GameState: Play Again was chosen by at least one crew member
+function IsleAdmission.rematch()
+	rematchWanted = true
+end
+
+return IsleAdmission
diff --git a/src/ServerScriptService/Server/SessionLock.luau b/src/ServerScriptService/Server/SessionLock.luau
new file mode 100644
index 0000000..45dd953
--- /dev/null
+++ b/src/ServerScriptService/Server/SessionLock.luau
@@ -0,0 +1,170 @@
+-- SessionLock (multi-ship phase 2): a save-session lock for moving players between servers (harbor <-> isle).
+-- NOT WIRED into PlayerData. Production saving is unchanged. Tested only against a fake in-memory store.
+--
+-- The lock lives in the DataStore key's METADATA (UpdateAsync can return value, userIds, metadata), so the saved
+-- profile itself never changes format. metadata.session = { token, job, at }:
+--   * token : a unique fencing token per claim (GUID). Every write must present the current token.
+--   * job   : the claiming server's JobId (for logs)
+--   * at    : last heartbeat (os.time). A session older than staleSeconds may be taken over (crashed server).
+--
+-- Rules (auditor list, 2026-10-15):
+--   1. claim(): atomic in UpdateAsync. If another live session holds the key, the write is cancelled (nil) and
+--      claim retries until waitSeconds, then fails (the caller keeps the player in memory-only mode).
+--   2. save(): atomic ownership check inside UpdateAsync; a stale or foreign token cancels the write.
+--   3. heartbeat(): refreshes `at` even when the profile is unchanged (same ownership check).
+--   4. Existing metadata fields and the key's UserIds are always carried over.
+--   5. release(): an awaited final save that also clears the session. After it, this lock refuses to write.
+--   6. reclaim after a failed teleport: claim() again; it succeeds at once because the key is free (or ours).
+--   7. Per-key operations are serialized (one at a time, in call order), so PlayerRemoving, autosave and
+--      release can never interleave inside one server.
+--   8. Old servers (pre-lock code) write without metadata, which clears any session. The lock then sees the key
+--      as free. Deploy only with "Shut down all servers" / "Migrate to latest update" so no old server runs
+--      beside new ones (see the phase 2 package).
+
+local HttpService = game:GetService("HttpService")
+
+local SessionLock = {}
+SessionLock.__index = SessionLock
+
+-- opts: store (UpdateAsync-compatible), jobId, staleSeconds (120), waitSeconds (15), now (os.time), sleep (task.wait)
+function SessionLock.new(opts)
+	return setmetatable({
+		store = opts.store,
+		jobId = opts.jobId or game.JobId,
+		staleSeconds = opts.staleSeconds or 120,
+		waitSeconds = opts.waitSeconds or 15,
+		now = opts.now or os.time,
+		sleep = opts.sleep or task.wait,
+		tokens = {}, -- key -> our current token (nil = not owned)
+		queues = {}, -- key -> { busy = bool, waiting = { threads } }
+	}, SessionLock)
+end
+
+local function copyMeta(keyInfo)
+	local meta = {}
+	if keyInfo then
+		for k, v in keyInfo:GetMetadata() or {} do
+			meta[k] = v
+		end
+	end
+	return meta
+end
+
+local function userIdsOf(keyInfo)
+	return if keyInfo then keyInfo:GetUserIds() else {}
+end
+
+-- serialize every operation on one key
+function SessionLock:_run(key, fn)
+	local q = self.queues[key]
+	if not q then
+		q = { busy = false, waiting = {} }
+		self.queues[key] = q
+	end
+	if q.busy then
+		table.insert(q.waiting, coroutine.running())
+		coroutine.yield()
+	end
+	q.busy = true
+	local results = table.pack(pcall(fn))
+	local nextThread = table.remove(q.waiting, 1)
+	if nextThread then
+		task.defer(nextThread) -- stays busy: ownership passes straight to the next waiter
+	else
+		q.busy = false
+	end
+	if not results[1] then
+		return false, tostring(results[2])
+	end
+	return table.unpack(results, 2, results.n)
+end
+
+-- Returns ok, value (the stored profile, possibly nil for a new player), reason
+function SessionLock:claim(key)
+	return self:_run(key, function()
+		local started = self.now()
+		while true do
+			local token = HttpService:GenerateGUID(false)
+			local busy, value = false, nil
+			local ok, err = pcall(function()
+				self.store:UpdateAsync(key, function(current, keyInfo)
+					local meta = copyMeta(keyInfo)
+					local s = meta.session
+					local mine = s ~= nil and s.token == self.tokens[key]
+					if s ~= nil and not mine and type(s.at) == "number" and self.now() - s.at < self.staleSeconds then
+						busy = true
+						return nil -- another live session: cancel the write
+					end
+					meta.session = { token = token, job = self.jobId, at = self.now() }
+					value = current
+					return current, userIdsOf(keyInfo), meta
+				end)
+			end)
+			if ok and not busy then
+				self.tokens[key] = token
+				return true, value, "claimed"
+			end
+			if self.now() - started >= self.waitSeconds then
+				return false, nil, if busy then "locked by another server" else "store error: " .. tostring(err)
+			end
+			self.sleep(1)
+		end
+	end)
+end
+
+-- shared body of save / heartbeat / release. newValue == nil keeps the stored value.
+function SessionLock:_write(key, newValue, releaseAfter)
+	local token = self.tokens[key]
+	if token == nil then
+		return false, "not owned"
+	end
+	local lost = false
+	local ok, err = pcall(function()
+		self.store:UpdateAsync(key, function(current, keyInfo)
+			local meta = copyMeta(keyInfo)
+			if meta.session == nil or meta.session.token ~= token then
+				lost = true
+				return nil -- fenced: somebody else owns the key now
+			end
+			meta.session = if releaseAfter then nil else { token = token, job = self.jobId, at = self.now() }
+			local value = if newValue ~= nil then newValue else current
+			return value, userIdsOf(keyInfo), meta
+		end)
+	end)
+	if lost then
+		self.tokens[key] = nil
+		return false, "lock lost"
+	end
+	if not ok then
+		return false, "store error: " .. tostring(err) -- still owned; the caller retries later
+	end
+	if releaseAfter then
+		self.tokens[key] = nil
+	end
+	return true, if releaseAfter then "released" else "saved"
+end
+
+function SessionLock:save(key, value)
+	return self:_run(key, function()
+		return self:_write(key, value, false)
+	end)
+end
+
+function SessionLock:heartbeat(key)
+	return self:_run(key, function()
+		return self:_write(key, nil, false)
+	end)
+end
+
+-- awaited final save + release (before a teleport, or when the player leaves)
+function SessionLock:release(key, value)
+	return self:_run(key, function()
+		return self:_write(key, value, true)
+	end)
+end
+
+function SessionLock:owns(key)
+	return self.tokens[key] ~= nil
+end
+
+return SessionLock
