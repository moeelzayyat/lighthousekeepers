+-- Leaving. Locked path: the profile is detached first (so no mutation can slip in after the final write), then the
+-- release writes the latest state. A claim still in flight is marked so load() gives its lock back (fix A).
+function PlayerData._onRemoving(player)
+	if loading[player] then
+		leftDuringLoad[player] = true
+	end
+	local profile = profiles[player]
+	if LOCKED and storeAvailable then
+		profiles[player] = nil
+		if profile and not profile.doNotSave then
+			lock:release(keyFor(player), profile)
+		elseif frozen[player] and lock:owns(keyFor(player)) then
+			lock:release(keyFor(player), frozen[player]) -- a hand-off whose release failed: release it now
+		end
+		frozen[player] = nil
+	elseif profile and not profile.doNotSave then
+		save(player)
+	end
+	profiles[player] = nil
+	dirty[player] = nil
+	generation[player] = nil
+end
